# Copy to .env and fill in. Both values are safe to ship in the app:
# Supabase protects the data with row-level security, not by hiding these.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Test project only: shows "sign in as a test person" on the welcome screen.
EXPO_PUBLIC_TEST_MODE=1
# The shared password the made-up people were seeded with (see supabase/seed.sql).
EXPO_PUBLIC_TEST_PASSWORD=
